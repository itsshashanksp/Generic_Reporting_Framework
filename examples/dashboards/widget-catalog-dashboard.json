{
  "id": "widget-catalog-dashboard",
  "title": "Widget Catalog",
  "layout": { "columns": 12, "tabletColumns": 6, "mobileColumns": 1 },
  "autoRefresh": { "enabled": true, "interval": 60000 },
  "filters": [{ "field": "OrderDate", "label": "Order Date", "type": "daterange", "operator": "between" }],
  "dateFilterBehavior": "optional",
  "widgets": [
    { "id": "report-reference", "type": "report", "title": "Orders", "reportId": "orders-json-example", "width": 12, "height": 420 },
    { "id": "reusable-table", "type": "table", "title": "Customer Summary", "widgetId": "customer-summary-widget", "width": 6, "pageSize": 10, "export": { "enabled": true, "formats": ["csv", "excel"], "exportAll": true } },
    { "id": "number-stat", "type": "stat", "title": "Orders", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": [{ "function": "COUNT", "field": "*", "alias": "Value" }] }, "valueField": "Value", "format": "number", "width": 2 },
    { "id": "currency-stat", "type": "stat", "title": "Total", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": [{ "function": "SUM", "field": "Amount", "alias": "Value" }] }, "valueField": "Value", "format": "currency", "width": 2 },
    { "id": "decimal-stat", "type": "stat", "title": "Average", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": [{ "function": "AVG", "field": "Amount", "alias": "Value" }] }, "valueField": "Value", "format": "decimal", "width": 2 },
    { "id": "bar-chart", "type": "chart", "title": "Bar", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["Status", { "function": "COUNT", "field": "*", "alias": "Value" }], "groupBy": ["Status"] }, "chartType": "bar", "xField": "Status", "yField": "Value", "showLegend": false, "showTooltip": true, "showGrid": true, "showLabels": false, "width": 4 },
    { "id": "line-chart", "type": "chart", "title": "Line", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["OrderDate", { "function": "SUM", "field": "Amount", "alias": "Value" }], "groupBy": ["OrderDate"] }, "chartType": "line", "xField": "OrderDate", "yField": "Value", "showLegend": true, "showTooltip": true, "showGrid": true, "showLabels": true, "width": 4 },
    { "id": "pie-chart", "type": "chart", "title": "Pie", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["Status", { "function": "COUNT", "field": "*", "alias": "Value" }], "groupBy": ["Status"] }, "chartType": "pie", "xField": "Status", "yField": "Value", "showLegend": true, "showTooltip": true, "showGrid": false, "showLabels": true, "width": 4 }
  ]
}
