{
  "id": "customer",
  "title": "Customer Report",
  "description": "Displays all customers.",

  "queryDefinition": {
  "format": "sql",
  "resource": "customer"
},
  "columns": [
    {
      "field": "Cust_Name",
      "header": "Customer Name"
    },
    {
      "field": "TotalCustomers",
      "header": "Total Customers"
    },
    {
      "field": "MinimumBill",
      "header": "Minimum Bill"
    },
    {
      "field": "MaximumBill",
      "header": "Maximum Bill"
    }
  ],

  "filters": [
    {
      "field": "Cust_Name",
      "label": "Customer",
      "type": "text"
    },
    {
      "field": "StDate",
      "label": "Start Date",
      "type": "daterange",
      "operator": "between"
    }
  ],

  "grid": {
    "pagination": {
      "enabled": true,
      "pageSize": 25,
      "pageSizeOptions": [
        25,
        50,
        100
      ]
    },
    "rowSelection": "multiple"
  },

  "toolbar": {
    "export": true,
    "refresh": true,
    "settings": false,
    "saveReport": false
  },

  "export": {
    "enabled": true,
    "formats": [
      "csv",
      "excel"
    ],
    "filename": "customer-report",
    "exportAll": true,
    "exportCurrentView": true
  }
}