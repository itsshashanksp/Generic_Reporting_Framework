{
  "id": "item-dashboard-stats",
  "title": "Item dashboard statistics",
  "queryDefinition": {
    "format": "sql",
    "resource": "widgets/item-dashboard-stats",
    "execution": {
      "columns": [
        "TotalItems",
        "MinimumSP",
        "MaximumSP",
        "StockValue"
      ],
      "filters": {
        "Item_Desc": {
          "expression": "Item_Desc",
          "placement": "source"
        },
        "Std_Vat": {
          "expression": "Std_Vat",
          "placement": "source"
        }
      }
    }
  },
  "filters": []
}
