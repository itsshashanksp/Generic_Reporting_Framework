{
  "id": "customer-dashboard",
  "title": "Item Dashboard",
  "description": "Item reporting dashboard.",
  "layout": {
    "columns": 12,
    "tabletColumns": 6,
    "mobileColumns": 1
  },
  "autoRefresh": {
    "enabled": false,
    "interval": 30000
  },
  "filters": [
    {
      "field": "Item_Desc",
      "label": "Item Name",
      "type": "text"
    },
    {
      "field": "Std_Vat",
      "label": "GST %",
      "type": "text"
    }
  ],
  "widgets": [
    {
      "id": "item-table",
      "type": "table",
      "title": "Item Details",
      "description": "Item records matching the selected filters.",
      "visible": true,
      "position": {
        "x": 0,
        "y": 1
      },
      "request": {
        "action": "select",
        "source": {
          "table": "ItemMasterTable"
        },
        "fields": [
          "Item_Code",
          "Item_Desc",
          "Sale_Rate",
          "Item_MRP",
          "Std_Vat"
        ]
      },
      "pageSize": 10,
      "export": {
        "enabled": true,
        "formats": [
          "csv",
          "excel"
        ],
        "filename": "item-details",
        "exportAll": true,
        "exportCurrentView": true
      }
    },
    {
      "id": "total-Items",
      "type": "stat",
      "title": "Total Items",
      "description": "Total number of Items matching the selected filters.",
      "width": 4,
      "height": 175,
      "visible": true,
      "position": {
        "x": 0,
        "y": 2
      },
      "request": {
        "action": "select",
        "source": {
          "table": "ItemMasterTable"
        },
        "fields": [
          {
            "function": "COUNT",
            "alias": "TotalItems",
            "field": "Item_Code"
          }
        ]
      },
      "format": "number"
    },
    {
      "id": "minimum-sp-item",
      "type": "stat",
      "title": "Minimum Sale Price",
      "width": 4,
      "height": 175,
      "visible": true,
      "position": {
        "x": 4,
        "y": 2
      },
      "request": {
        "action": "select",
        "source": {
          "table": "ItemMasterTable"
        },
        "fields": [
          {
            "function": "MIN",
            "alias": "MinimumSP",
            "field": "Sale_Rate"
          }
        ]
      },
      "format": "currency"
    },
    {
      "id": "maximum-sp-item",
      "type": "stat",
      "title": "Maximum Sale Price",
      "width": 4,
      "height": 175,
      "visible": true,
      "position": {
        "x": 8,
        "y": 2
      },
      "request": {
        "action": "select",
        "source": {
          "table": "ItemMasterTable"
        },
        "fields": [
          {
            "function": "MAX",
            "alias": "MaximumSP",
            "field": "Sale_Rate"
          }
        ]
      },
      "format": "currency"
    },
    {
      "id": "total-value",
      "type": "stat",
      "title": "Total Value",
      "width": 4,
      "height": 175,
      "visible": true,
      "position": {
        "x": 0,
        "y": 3
      },
      "request": {
        "action": "select",
        "source": {
          "table": "ItemMasterTable"
        },
        "fields": [
          {
            "function": "SUM",
            "alias": "TotalValue",
            "field": "Sale_Rate"
          }
        ]
      },
      "format": "currency"
    }
  ]
}
