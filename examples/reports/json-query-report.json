{
  "id": "orders-json-example",
  "title": "Orders (JSON Query)",
  "description": "JSON Query report with dynamic options, paging and exports over an illustrative schema.",
  "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["OrderId", "CustomerName", "Amount", "Status", "OrderDate"] },
  "columns": [
    { "field": "OrderId", "header": "Order", "dataType": "number", "width": 120 },
    { "field": "CustomerName", "header": "Customer", "width": 260 },
    { "field": "Amount", "header": "Amount", "dataType": "number" },
    { "field": "Status", "header": "Status" },
    { "field": "OrderDate", "header": "Order Date", "dataType": "date" }
  ],
  "sort": [{ "field": "OrderDate", "direction": "DESC" }],
  "filters": [
    { "field": "CustomerName", "label": "Customer", "type": "text", "operator": "contains" },
    { "field": "Amount", "label": "Amount", "type": "number", "operator": "between" },
    { "field": "Status", "label": "Status", "type": "select", "dynamicOptions": {
      "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["Status", { "function": "COUNT", "field": "*", "alias": "Frequency" }], "groupBy": ["Status"], "sort": [{ "field": "Frequency", "direction": "DESC" }], "limit": 100 },
      "valueField": "Status", "countField": "Frequency", "searchable": true
    } }
  ],
  "grid": { "pagination": { "enabled": true, "pageSize": 25, "pageSizeOptions": [10, 25, 50] }, "rowSelection": "single" },
  "toolbar": { "export": true, "refresh": true, "saveReport": true },
  "export": { "enabled": true, "formats": ["csv", "excel"], "filename": "orders", "exportCurrentView": true, "exportAll": true }
}
