{
  "id": "bill-dashboard",
  "title": "Bill Dashboard",
  "description": "Month-wise sales, category-wise sales and month-wise purchases for the selected date range.",
  "layout": {
    "columns": 12,
    "tabletColumns": 6,
    "mobileColumns": 1
  },
  "autoRefresh": {
    "enabled": false,
    "interval": 30000
  },
  "dateFilterBehavior": "required",
    "filters": [
    {
      "field": "Bill_Date",
      "label": "Start Date",
      "type": "daterange",
      "operator": "between",
      "required": true
    }
  ],
  "widgets": [
    {
      "id": "sales-month-wise",
      "type": "table",
      "title": "Total Sales Month Wise",
      "description": "Sales by calendar month for the selected date range; the same month in different years is combined.",
      "width": 6,
      "visible": true,
      "position": {
        "x": 0,
        "y": 1
      },
      "queryDefinition": {
        "format": "sql",
        "database": "loyal-ibms",
        "resource": "widgets/bill-sales-month-wise"
      },
      "columns": [
        {
          "field": "Month",
          "header": "Month"
        },
        {
          "field": "Sales",
          "header": "Sales",
          "dataType": "number"
        }
      ],
      "sort": [{ "field": "Month", "direction": "DESC" }],
      "pageSize": 10,
      "export": {
        "enabled": true,
        "formats": ["csv", "excel"],
        "exportCurrentView": true,
        "exportAll": true,
        "filename": "sales-month-wise"
      }
    },
    {
      "id": "purchases-month-wise",
      "type": "table",
      "filterFields": { "Bill_Date": "GIN_Date" },
      "title": "Purchases Month Wise",
      "description": "Purchases by calendar month for the selected date range; the same month in different years is combined.",
      "width": 6,
      "visible": true,
      "position": {
        "x": 6,
        "y": 1
      },
      "queryDefinition": {
        "format": "sql",
        "database": "loyal-ibms",
        "resource": "widgets/bill-purchases-month-wise"
      },
      "columns": [
        {
          "field": "Month",
          "header": "Month"
        },
        {
          "field": "Purchases",
          "header": "Purchases",
          "dataType": "number"
        }
      ],
      "sort": [{ "field": "Month", "direction": "DESC" }],
      "pageSize": 10,
      "export": {
        "enabled": true,
        "formats": ["csv", "excel"],
        "exportCurrentView": true,
        "exportAll": true,
        "filename": "purchases-month-wise"
      }
    },
    {
      "id": "top-10-categories",
      "type": "table",
      "title": "Top 10 Item Category Sales",
      "description": "Ten highest selling item categories for the selected date range.",
      "width": 6,
      "visible": true,
      "position": {
        "x": 0,
        "y": 2
      },
      "queryDefinition": {
        "format": "sql",
        "database": "loyal-ibms",
        "resource": "widgets/bill-top-10-categories"
      },
      "columns": [
        {
          "field": "Category",
          "header": "Category"
        },
        {
          "field": "Sales",
          "header": "Sales",
          "dataType": "number"
        }
      ],
      "sort": [{ "field": "Sales", "direction": "DESC" }],
      "pageSize": 10,
      "export": {
        "enabled": true,
        "formats": ["csv", "excel"],
        "exportCurrentView": true,
        "exportAll": true,
        "filename": "top-10-categories"
      }
    },
    {
      "id": "top-10-month-wise-category-wise",
      "type": "table",
      "title": "Top 10 Month Wise Category Wise Sales",
      "description": "Top 10 category sales for each calendar month in the selected date range; the same month in different years is combined.",
      "width": 6,
      "visible": true,
      "position": {
        "x": 0,
        "y": 3
      },
      "queryDefinition": {
        "format": "sql",
        "database": "loyal-ibms",
        "resource": "widgets/bill-top-10-month-wise-category-wise"
      },
      "columns": [
        {
          "field": "Month",
          "header": "Month"
        },
        {
          "field": "Category",
          "header": "Category"
        },
        {
          "field": "Sales",
          "header": "Sales",
          "dataType": "number"
        }
      ],
      "sort": [{ "field": "Sales", "direction": "DESC" }],
      "pageSize": 10,
      "export": {
        "enabled": true,
        "formats": ["csv", "excel"],
        "exportCurrentView": true,
        "exportAll": true,
        "filename": "top-10-month-wise-category-wise"
      }
    },
    {
      "id": "category-sales-month-wise",
      "type": "table",
      "title": "Month Wise / Category Wise Sales",
      "description": "Category sales by calendar month for the selected date range; the same month in different years is combined.",
      "width": 6,
      "visible": true,
      "position": {
        "x": 6,
        "y": 2
      },
      "queryDefinition": {
        "format": "sql",
        "database": "loyal-ibms",
        "resource": "widgets/bill-category-sales-month-wise"
      },
      "columns": [
        {
          "field": "Month",
          "header": "Month"
        },
        {
          "field": "Category",
          "header": "Category"
        },
        {
          "field": "Sales",
          "header": "Sales",
          "dataType": "number"
        }
      ],
      "sort": [
        { "field": "Month", "direction": "ASC" },
        { "field": "Category", "direction": "ASC" }
      ],
      "pageSize": 10,
      "export": {
        "enabled": true,
        "formats": ["csv", "excel"],
        "exportCurrentView": true,
        "exportAll": true,
        "filename": "category-sales-month-wise"
      }
    },
    {
      "id": "total-sales",
      "type": "stat",
      "title": "Total Sales",
      "description": "Total sales for the selected date range.",
      "width": 4,
      "height": 175,
      "visible": true,
      "position": {
        "x": 0,
        "y": 4
      },
      "queryDefinition": {
        "format": "sql",
        "database": "loyal-ibms",
        "resource": "widgets/bill-total-sales"
      },
      "valueField": "TotalSales",
      "format": "currency"
    },
    {
      "id": "total-purchases",
      "type": "stat",
      "filterFields": { "Bill_Date": "GIN_Date" },
      "title": "Total Purchases",
      "description": "Total purchases for the selected date range.",
      "width": 4,
      "height": 175,
      "visible": true,
      "position": {
        "x": 4,
        "y": 4
      },
      "queryDefinition": {
        "format": "sql",
        "resource": "widgets/bill-total-purchases"
      },
      "valueField": "TotalPurchases",
      "format": "currency"
    }
  ]
}
