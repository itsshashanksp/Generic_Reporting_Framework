{
  "id": "customer",
  "title": "Customer Report",
  "description": "Displays all customers.",
  "request": {
    "action": "select",
    "source": {
      "table": "CustomerTable"
    },
    "fields": [
      "Cust_Name",
      {
        "function": "COUNT",
        "field": "Cust_Name",
        "alias": "TotalCustomers"
      },
      {
        "function": "MIN",
        "field": "Bill_Amt",
        "alias": "MinimumBill"
      },
      {
        "function": "MAX",
        "field": "Bill_Amt",
        "alias": "MaximumBill"
      }
    ],
    "groupBy": ["Cust_Name"]
  },

  "columns": [
    {
      "field": "Cust_Name",
      "header": "Customer Name"
    },
    {
      "field": "TotalCustomers",
      "header": "Total Customers",
      "dataType": "number"
    },
    {
      "field": "MinimumBill",
      "header": "Minimum Bill",
      "dataType": "number"
    },
    {
      "field": "MaximumBill",
      "header": "Maximum Bill",
      "dataType": "number"
    }
  ],

  "sort": [
    {
      "field": "Cust_Name",
      "direction": "ASC"
    }
  ],

  "filters": [
    {
      "field": "Cust_Name",
      "label": "Customer",
      "type": "text"
    },
    {
      "field": "StDate",
      "label": "Start Date",
      "type": "daterange",
      "operator": "between"
    }
  ],

  "grid": {
    "pagination": {
      "enabled": true,
      "pageSize": 10,
      "pageSizeOptions": [10, 25, 50, 100]
    },
    "rowSelection": "multiple"
  },

  "toolbar": {
    "export": true,
    "refresh": true,
    "saveReport": false
  },

  "export": {
    "enabled": true,
    "formats": ["csv", "excel"],
    "filename": "customer-report",
    "exportAll": true,
    "exportCurrentView": true
  }
}
