{
  "id": "customer",
  "title": "Customer Report",
  "description": "Displays all customers.",
  "request": {
    "action": "select",
    "source": {
      "table": "CustomerTable"
    },
    "fields": [
      "*"
    ]
  },
  "columns": [
    {
      "field": "Cust_Name",
      "header": "Customer Name"
    },
    {
      "field": "Cust_Add",
      "header": "Address"
    },
    {
      "field": "Cust_Phon4",
      "header": "Mobile"
    }
  ],
  "filters": [
    {
      "field": "Cust_Name",
      "label": "Customer",
      "type": "text"
    },
    {
      "field": "StDate",
      "label": "Start Date",
      "type": "daterange",
      "operator": "between"
    }
  ],
  "grid": {
    "pagination": {
      "enabled": true,
      "pageSize": 25,
      "pageSizeOptions": [
        25,
        50,
        100
      ]
    },
    "rowSelection": "multiple",
    "grouping": {
      "enabled": true,
      "groups": [
        {
          "field": "Cust_Name",
          "header": "Customer Name"
        }
      ],
      "aggregates": [
        {
          "field": "Cust_Name",
          "function": "COUNT",
          "alias": "TotalCustomers",
          "header": "Total Customers"
        },
        {
          "field": "Bill_Amt",
          "function": "MIN",
          "alias": "MinimumBill",
          "header": "Minimum Bill"
        },
        {
          "field": "Bill_Amt",
          "function": "MAX",
          "alias": "MaximumBill",
          "header": "Maximum Bill"
        }
      ]
    }
  },
  "toolbar": {
    "export": true,
    "refresh": true,
    "settings": false,
    "saveReport": false
  },
  "export": {
    "enabled": true,
    "formats": [
      "csv",
      "excel"
    ],
    "filename": "customer-report",
    "exportAll": true,
    "exportCurrentView": true
  }
}
