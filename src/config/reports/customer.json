{
  "id": "customer",
  "title": "Customer Report",
  "description": "Displays all customers.",

  "toolbar": {
    "search": true,
    "export": true,
    "refresh": true,
    "settings": false
  },

  "grid": {
    "pagination": {
      "enabled": true,
      "pageSize": 100,
      "pageSizeOptions": [25, 50, 100]
    },

    "rowSelection": "multiple",

    "grouping": {
      "enabled": true,

      "groups": [
        {
          "field": "Cust_Name",
          "header": "Customer Name"
        }
      ],
 
      "aggregates": [
        {
          "field": "Cust_Name",
          "function": "COUNT",
          "alias": "TotalCustomers",
          "header": "Total Customers"
        },
        {
          "field": "Bill_Amt",
          "function": "MIN",
          "alias": "MinimumBill",
          "header": "Minimum Bill"
        },
        {
          "field": "Bill_Amt",
          "function": "MAX",
          "alias": "MaximumBill",
          "header": "Maximum Bill"
        }
      ]
    }
  },

  "columns": [
    {
      "field": "Cust_Name",
      "header": "Customer Name"
    },
    {
      "field": "Cust_Add",
      "header": "Address"
    },
    {
      "field": "Cust_Phon4",
      "header": "Mobile"
    }
  ],

  "filters": [
    {
      "field": "Cust_Name",
      "label": "Customer Name",
      "type": "text"
    },
    {
      "field": "Cust_Add",
      "label": "Address",
      "type": "text"
    }
  ],

  "request": {
    "controller": "Query",
    "action": "select",
    "table": "CustomerTable",
    "columns": ["*"]
  }
}