{
  "id": "sales-database-selector-example",
  "title": "Sales Dashboard (database selector example)",
  "description": "Widgets without their own database follow the Database dropdown; the stock chart stays on loyal-ibms.",
  "databaseSelection": true,
  "widgets": [
    {
      "id": "total-sales",
      "type": "stat",
      "title": "Total Sales",
      "width": 4,
      "queryDefinition": { "format": "sql", "resource": "widgets/total-sales" },
      "valueField": "TotalSales",
      "format": "currency"
    },
    {
      "id": "sales-month-wise",
      "type": "table",
      "title": "Sales Month Wise",
      "width": 8,
      "queryDefinition": { "format": "sql", "resource": "widgets/sales-month-wise" },
      "columns": [
        { "field": "Month", "header": "Month" },
        { "field": "Sales", "header": "Sales", "dataType": "number" }
      ],
      "sort": [{ "field": "Month", "direction": "DESC" }],
      "export": { "enabled": true, "formats": ["csv", "excel"], "exportAll": true }
    },
    {
      "id": "stock-value",
      "type": "chart",
      "title": "Stock Value by Category (always loyal-ibms)",
      "width": 12,
      "height": 350,
      "queryDefinition": { "format": "sql", "database": "loyal-ibms", "resource": "widgets/item-stock-value-by-category" },
      "chartType": "pie",
      "xField": "Category",
      "yField": "StockValue"
    }
  ]
}
