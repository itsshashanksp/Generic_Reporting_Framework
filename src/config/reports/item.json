{
  "id": "item",
  "title": "Item Report",
  "description": "Displays all items.",

  "queryDefinition": {
    "format": "sql",
    "resource": "reports/item",
    "execution": {
      "columns": [
        "Item_Code",
        "Item_Desc",
        "Item_MRP"
      ],
      "filters": {
        "UserName": {
          "expression": "UserName",
          "placement": "source"
        }
      },
      "defaultSort": [
        {
          "field": "Item_Code",
          "direction": "ASC"
        }
      ]
    }
  },

  "columns": [
    {
      "field": "Item_Code",
      "header": "Item Code"
    },
    {
      "field": "Item_Desc",
      "header": "Item Description"
    },
    {
      "field": "Item_MRP",
      "header": "Item MRP"
    }
  ],

  "filters": [
    {
      "field": "Item_Code",
      "label": "Item Code",
      "type": "text"
    },
    {
      "field": "Item_Desc",
      "label": "Item Description",
      "type": "text"
    },
    {
      "field": "UserName",
      "label": "User Name",
      "type": "select",
      "dynamicOptions": {
        "request": {
          "action": "select",
          "source": {
            "table": "ItemMasterTable"
          },
          "fields": [
            "UserName",
            {
              "function": "COUNT",
              "field": "*",
              "alias": "Frequency"
            }
          ],
          "groupBy": [
            "UserName"
          ],
          "sort": [
            {
              "field": "Frequency",
              "direction": "DESC"
            }
          ],
          "limit": 1000
        },
        "valueField": "UserName",
        "countField": "Frequency",
        "searchable": false
      }
    }
  ],

  "grid": {
    "pagination": {
      "enabled": true,
      "pageSize": 10,
      "pageSizeOptions": [
        10,
        25,
        50,
        100
      ]
    },
    "rowSelection": "multiple"
  },

  "toolbar": {
    "export": true,
    "refresh": true,
    "saveReport": false
  },

  "export": {
    "enabled": true,
    "formats": [
      "csv",
      "excel"
    ],
    "filename": "item-report",
    "exportAll": true,
    "exportCurrentView": true
  }
}
