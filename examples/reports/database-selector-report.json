{
  "id": "orders-database-selector-example",
  "title": "Orders (Database Selector)",
  "description": "Runs the same illustrative DemoOrders query on an authorized database selected at runtime.",
  "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["OrderId", "CustomerName", "Amount"] },
  "databaseSelection": true,
  "columns": [
    { "field": "OrderId", "header": "Order", "dataType": "number" },
    { "field": "CustomerName", "header": "Customer" },
    { "field": "Amount", "header": "Amount", "dataType": "number" }
  ],
  "sort": [{ "field": "OrderId", "direction": "ASC" }],
  "filters": [{ "field": "CustomerName", "label": "Customer", "type": "text" }],
  "export": { "enabled": true, "formats": ["csv", "excel"], "exportAll": true }
}
