{
  "id": "demo-orders-reporting-grid",
  "title": "Orders by Year, Month and Category",
  "description": "Client-generated nested groups, subtotals, grand totals and grouped export from ordinary DemoOrders records.",
  "request": {
    "action": "select",
    "source": { "table": "DemoOrders" },
    "fields": ["OrderId", "OrderYear", "OrderMonth", "Category", "Amount", "Quantity"]
  },
  "columns": [
    { "field": "OrderId", "header": "Order", "dataType": "number", "visible": true, "sortable": true },
    { "field": "OrderYear", "header": "Year", "dataType": "number", "visible": true, "sortable": true },
    { "field": "OrderMonth", "header": "Month", "visible": true, "sortable": true },
    { "field": "Category", "header": "Category", "visible": true, "sortable": true },
    { "field": "Amount", "header": "Sales", "dataType": "currency", "visible": true, "sortable": true },
    { "field": "Quantity", "header": "Quantity", "dataType": "number", "visible": true, "sortable": true }
  ],
  "filters": [
    { "field": "OrderYear", "label": "Year", "type": "number", "operator": "equals" },
    { "field": "Category", "label": "Category", "type": "text", "operator": "contains" }
  ],
  "sort": [
    { "field": "OrderYear", "direction": "ASC" },
    { "field": "OrderMonth", "direction": "ASC" },
    { "field": "Category", "direction": "ASC" }
  ],
  "grid": {
    "pagination": { "enabled": true, "pageSize": 10, "pageSizeOptions": [10, 25, 50], "style": "modern", "showTotalRecords": true, "showPageNumbers": true, "showFirstLast": true },
    "rowSelection": "multiple",
    "grouping": {
      "enabled": true,
      "groups": [
        { "field": "OrderYear", "header": "Year" },
        { "field": "OrderMonth", "header": "Month" },
        { "field": "Category", "header": "Category" }
      ],
      "aggregates": [
        { "field": "Amount", "function": "SUM", "header": "Sales" },
        { "field": "OrderId", "function": "COUNT", "header": "Orders" },
        { "field": "Quantity", "function": "AVG", "header": "Average Quantity" }
      ],
      "expandedByDefault": true,
      "showSubtotals": true,
      "showGrandTotal": true,
      "showGroupTotalsInHeader": true,
      "subtotalPosition": "bottom",
      "exportMode": "grouped"
    }
  },
  "toolbar": { "export": true, "refresh": true, "saveReport": true },
  "export": { "enabled": true, "formats": ["csv", "excel"], "filename": "demo-orders-reporting-grid", "exportCurrentView": false, "exportAll": true }
}
