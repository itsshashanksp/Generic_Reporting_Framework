{
  "id": "demo-filter-catalog",
  "title": "Filter Catalog",
  "description": "Standalone structural example of every supported filter type and representative operators.",
  "request": {
    "action": "select",
    "source": { "table": "DemoOrders", "alias": "o" },
    "fields": ["OrderId", "CustomerName", "Amount", "Status", "IsActive", "OrderDate"]
  },
  "columns": [
    { "field": "OrderId", "header": "Order", "dataType": "number", "width": 110, "visible": true, "sortable": true },
    { "field": "CustomerName", "header": "Customer", "width": 240 },
    { "field": "Amount", "header": "Amount", "dataType": "number" },
    { "field": "Status", "header": "Status" },
    { "field": "IsActive", "header": "Active", "dataType": "boolean" },
    { "field": "OrderDate", "header": "Order Date", "dataType": "date" }
  ],
  "filters": [
    { "field": "CustomerName", "label": "Customer contains", "type": "text", "operator": "contains", "placeholder": "Search customers", "required": false },
    { "field": "CustomerPrefix", "label": "Customer starts with", "type": "text", "operator": "startsWith" },
    { "field": "CustomerSuffix", "label": "Customer ends with", "type": "text", "operator": "endsWith", "visible": false },
    { "field": "Amount", "label": "Amount range", "type": "number", "operator": "between", "placeholder": "Minimum and maximum" },
    { "field": "MinimumAmount", "label": "Minimum amount", "type": "number", "operator": "greaterThanOrEqual" },
    { "field": "MaximumAmount", "label": "Maximum amount", "type": "number", "operator": "lessThan" },
    { "field": "Status", "label": "Status", "type": "select", "operator": "equals", "options": [
      { "label": "Open", "value": "OPEN", "count": 12 },
      { "label": "Closed", "value": "CLOSED", "count": 8 }
    ] },
    { "field": "Regions", "label": "Regions", "type": "multiselect", "operator": "in", "options": [
      { "label": "North", "value": "N" }, { "label": "South", "value": "S" }
    ] },
    { "field": "IsActive", "label": "Active", "type": "boolean", "operator": "equals" },
    { "field": "OrderDate", "label": "Order date", "type": "date", "operator": "equals" },
    { "field": "OrderDateRange", "label": "Order date range", "type": "daterange", "operator": "between", "required": true },
    { "field": "ArchivedAt", "label": "Not archived", "type": "date", "operator": "isNull" }
  ],
  "filterLogic": "AND",
  "sort": [
    { "field": "OrderDate", "direction": "DESC" },
    { "field": "OrderId", "direction": "ASC" }
  ],
  "grid": {
    "pagination": { "enabled": true, "pageSize": 25, "pageSizeOptions": [10, 25, 50, 100] },
    "rowSelection": "multiple",
    "grouping": { "enabled": true, "groups": [{ "field": "Status", "header": "Status" }], "aggregates": [{ "field": "Amount", "function": "SUM", "alias": "TotalAmount", "header": "Total Amount" }] }
  },
  "toolbar": { "export": true, "refresh": true, "saveReport": true },
  "export": { "enabled": true, "formats": ["csv", "excel"], "filename": "demo-orders", "exportCurrentView": true, "exportAll": true }
}
