{
  "id": "item-dashboard",
  "title": "Item Dashboard",
  "description": "Item reporting dashboard.",

  "layout": {
    "columns": 12,
    "tabletColumns": 6,
    "mobileColumns": 1
  },

  "autoRefresh": {
    "enabled": false,
    "interval": 30000
  },

  "filters": [
    {
      "field": "Item_Desc",
      "label": "Item Name",
      "type": "text"
    },
    {
      "field": "Br_code",
      "label": "Brand Code",
      "type": "text"
    },
    {
      "field": "Cat_code",
      "label": "Cat Code",
      "type": "text"
    },
    {
      "field": "Std_Vat",
      "label": "GST %",
      "type": "select",
      "dynamicOptions": {
        "request": {
          "action": "select",
          "source": {
            "table": "ItemMasterTable"
          },
          "fields": [
            "Std_Vat",
            {
              "function": "COUNT",
              "field": "*",
              "alias": "Frequency"
            }
          ],
          "groupBy": ["Std_Vat"],
          "sort": [
            {
              "field": "Frequency",
              "direction": "DESC"
            }
          ],
          "limit": 1000
        },
        "valueField": "Std_Vat",
        "countField": "Frequency",
        "searchable": false
      }
    }
  ],

  "widgets": [
    {
      "id": "item-table",
      "type": "table",
      "title": "Item Details",
      "visible": true,

      "position": {
        "x": 0,
        "y": 1
      },

      "queryDefinition": {
        "format": "sql",
        "resource": "widgets/item-dashboard-table"
      },

      "columns": [
        {
          "field": "Item_Code",
          "header": "Item Code",
          "dataType": "number"
        },
        {
          "field": "Item_Desc",
          "header": "Item Description"
        },
        {
          "field": "Sale_Rate",
          "header": "Sale Rate",
          "dataType": "number"
        },
        {
          "field": "Item_MRP",
          "header": "Item MRP",
          "dataType": "number"
        },
        {
          "field": "Std_Vat",
          "header": "GST %",
          "dataType": "number"
        },
        {
          "field": "cl_stock",
          "header": "Closing Stock",
          "dataType": "number"
        },
        {
          "field": "stock_value",
          "header": "Stock Value",
          "dataType": "number"
        }
      ],

      "sort": [
        {
          "field": "Item_Code",
          "direction": "ASC"
        }
      ],

      "pageSize": 10,

      "export": {
        "enabled": true,
        "formats": ["csv", "excel"],
        "filename": "item-details",
        "exportAll": true,
        "exportCurrentView": true
      }
    },

    {
      "id": "total-Items",
      "type": "stat",
      "title": "Total Items",
      "description": "Total number of Items matching the selected filters.",
      "width": 4,
      "height": 175,
      "visible": true,

      "position": {
        "x": 0,
        "y": 2
      },

      "queryDefinition": {
        "format": "sql",
        "resource": "widgets/item-dashboard-stats"
      },

      "valueField": "TotalItems",
      "format": "number"
    },

    {
      "id": "minimum-sp-item",
      "type": "stat",
      "title": "Minimum Sale Price",
      "description": "Minimum sale price of items matching the selected filters.",
      "width": 4,
      "height": 175,
      "visible": true,

      "position": {
        "x": 4,
        "y": 2
      },

      "queryDefinition": {
        "format": "sql",
        "resource": "widgets/item-dashboard-stats"
      },

      "valueField": "MinimumSP",
      "format": "currency"
    },

    {
      "id": "maximum-sp-item",
      "type": "stat",
      "title": "Maximum Sale Price",
      "description": "Maximum sale price of items matching the selected filters.",
      "width": 4,
      "height": 175,
      "visible": true,

      "position": {
        "x": 8,
        "y": 2
      },

      "queryDefinition": {
        "format": "sql",
        "resource": "widgets/item-dashboard-stats"
      },

      "valueField": "MaximumSP",
      "format": "currency"
    },

    {
      "id": "stock-value",
      "type": "stat",
      "title": "Stock Value",
      "description": "Stock value of items matching the selected filters.",
      "width": 4,
      "height": 175,
      "visible": true,

      "position": {
        "x": 0,
        "y": 3
      },

      "queryDefinition": {
        "format": "sql",
        "resource": "widgets/item-dashboard-stats"
      },

      "valueField": "StockValue",
      "format": "currency"
    }
  ]
}
