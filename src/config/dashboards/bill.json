      "visible": true,
      "position": {
        "x": 0,
        "y": 1
      },
      "queryDefinition": {
        "format": "sql",
        "resource": "bill-sales-month-wise"
      },
      "columns": [
        {
          "field": "Month",
          "header": "Month"
        },
        {
          "field": "Sales",
          "header": "Sales"
        }
