{
  "id": "widget-catalog-dashboard",
  "title": "Widget Catalog",
  "layout": { "columns": 12, "tabletColumns": 6, "mobileColumns": 1 },
  "autoRefresh": { "enabled": true, "interval": 60000 },
  "filters": [{ "field": "OrderDate", "label": "Order Date", "type": "daterange", "operator": "between", "targetGrids": ["report-reference", "reusable-table"] }],
  "dateFilterBehavior": "optional",
  "widgets": [
    { "id": "report-reference", "type": "report", "title": "Orders", "reportId": "orders-json-example", "width": 12, "height": 420 },
    { "id": "reusable-table", "type": "table", "title": "Customer Summary", "widgetId": "customer-summary-widget", "columns": [{ "field": "Customer", "header": "Customer", "dataType": "text" }, { "field": "Total", "header": "Total", "dataType": "currency", "align": "right" }], "width": 6, "pagination": { "pageSize": 10, "pageSizeOptions": [10, 25, 50], "showTotalRecords": true, "showPageNumbers": true, "showFirstLast": true }, "export": { "enabled": true, "formats": ["csv", "excel"], "exportCurrentView": true, "exportAll": true } },
    { "id": "number-stat", "type": "stat", "title": "Orders", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": [{ "function": "COUNT", "field": "*", "alias": "Value" }] }, "valueField": "Value", "format": "number", "runtimeFilters": [{ "field": "Status", "label": "Status", "type": "text", "operator": "equals" }], "runtimeFilterDisplay": "dialog", "width": 2 },
    { "id": "currency-stat", "type": "stat", "title": "Total", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": [{ "function": "SUM", "field": "Amount", "alias": "Value" }] }, "valueField": "Value", "format": "currency", "width": 2 },
    { "id": "decimal-stat", "type": "stat", "title": "Average", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": [{ "function": "AVG", "field": "Amount", "alias": "Value" }] }, "valueField": "Value", "format": "decimal", "width": 2 },
    { "id": "bar-chart", "type": "chart", "title": "Horizontal Bar", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["Status", { "function": "COUNT", "field": "*", "alias": "Value" }], "groupBy": ["Status"] }, "chartType": "bar", "xField": "Status", "yField": "Value", "showTooltip": true, "chartOptions": { "orientation": "horizontal", "showLegend": false, "showGrid": true, "showLabels": false, "topN": 12, "showOthers": true, "seriesColors": { "Value": "#2563EB" } }, "export": { "enabled": true, "formats": ["png", "svg", "csv", "excel"], "filename": "orders-by-status" }, "width": 6, "height": 440 },
    { "id": "line-chart", "type": "chart", "title": "Line", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["OrderDate", { "function": "SUM", "field": "Amount", "alias": "Value" }], "groupBy": ["OrderDate"] }, "chartType": "line", "xField": "OrderDate", "yField": "Value", "showTooltip": true, "chartOptions": { "showLegend": true, "showGrid": true, "showLabels": true, "smooth": true, "showPoints": true }, "export": { "enabled": true, "formats": ["png", "svg", "csv", "excel"] }, "width": 4 },
    { "id": "pie-chart", "type": "chart", "title": "Donut", "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["Status", { "function": "COUNT", "field": "*", "alias": "Value" }], "groupBy": ["Status"] }, "chartType": "pie", "xField": "Status", "yField": "Value", "showTooltip": true, "chartOptions": { "appearance": "donut", "showLegend": true, "showLabels": true, "showCenterTotal": true, "topN": 8, "showOthers": true, "othersLabel": "Other statuses", "categoryColors": { "Open": "#2563EB", "Closed": "#16A34A" } }, "export": { "enabled": true, "formats": ["png", "svg", "csv", "excel"] }, "width": 6, "height": 440 }
  ]
}
