{
  "id": "customer",
  "title": "Customer Report",
  "description": "Displays all customers.",

  "toolbar": {
    "export": true,
    "refresh": true,
    "settings": false
  },

  "grid": {
    "pagination": {
      "enabled": true,
      "pageSize": 50,
      "pageSizeOptions": [25, 50, 100]
    },

    "rowSelection": "multiple",

    "grouping": {
      "enabled": true,

      "groups": [
        {
          "field": "Cust_Name",
          "header": "Customer Name"
        }
      ],
 
      "aggregates": [
        {
          "field": "Cust_Name",
          "function": "COUNT",
          "alias": "TotalCustomers",
          "header": "Total Customers"
        },
        {
          "field": "Bill_Amt",
          "function": "MIN",
          "alias": "MinimumBill",
          "header": "Minimum Bill"
        },
        {
          "field": "Bill_Amt",
          "function": "MAX",
          "alias": "MaximumBill",
          "header": "Maximum Bill"
        }
      ]
    }
  },

  "export": {
    "enabled": true,
    "formats": [
        "csv",
        "excel"
    ],
    "filename": "customer-report",
    "exportAll": true,
    "exportCurrentView": true
},

  "columns": [
    {
      "field": "Cust_Name",
      "header": "Customer Name"
    },
    {
      "field": "Cust_Add",
      "header": "Address"
    },
    {
      "field": "Cust_Phon4",
      "header": "Mobile"
    }
  ],

"filters": [
  {
    "field": "Cust_Name",
    "label": "Customer",
    "type": "multiselect",
    "operator": "in",
    "options": [
      {
        "label": "7019901585",
        "value": "7019901585"
      },
      {
        "label": "7259381613",
        "value": "7259381613"
      },
      {
        "label": "7349488617",
        "value": "7349488617"
      }
    ]
  },
  {
    "field": "Cust_Add",
    "label": "Address",
    "type": "text",
    "operator": "endsWith"
  },
  {
    "field": "StDate",
    "label": "Start Date",
    "type": "daterange",
    "operator": "between",
    "format": "YYYYMMDD"
  }
],

  "request": {
    "controller": "Query",
    "action": "select",
    "table": "CustomerTable",
    "columns": ["*"]
  }
}
