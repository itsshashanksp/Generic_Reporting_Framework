{
  "id": "receipts-dashboard",
  "title": "Sales Receipts Dashboard",
  "description": "Reports for Sales Receipts From Customers.",
  "layout": {
    "columns": 12,
    "tabletColumns": 6,
    "mobileColumns": 1
  },
  "autoRefresh": {
    "enabled": false,
    "interval": 30000
  },
  "filters": [
    {
      "field": "Bill_Date",
      "label": "Purchase Date",
      "type": "daterange",
      "operator": "between"
    }
  ],
  "widgets": [
    {
      "id": "daily-collection-summary",
      "type": "table",
      "title": "Daily Collection Summary",
      "description": "Daily Collection Summary",
      "width": 6,
      "visible": true,
      "position": {
        "x": 0,
        "y": 1
      },
      "queryDefinition": {
        "format": "sql",
        "resource": "widgets/daily-collection-summary"
      },
      "columns": [
        {
          "field": "Date",
          "header": "Date"
        },
        {
          "field": "Receipt_Count",
          "header": "No Of Bills",
          "dataType": "number"
        },
        {
          "field": "Total_Collection",
          "header": "Total Collection",
          "dataType": "number"
        },
        {
          "field": "Total_Commission",
          "header": "Total Commission",
          "dataType": "number"
        },
        {
          "field": "Bill_Date",
          "header": "Bill Date",
          "visible": false
        }
      ],
      "sort": [
        {
          "field": "Bill_Date",
          "direction": "DESC"
        }
      ],
      "pageSize": 10,
      "export": {
        "enabled": true,
        "formats": [
          "csv",
          "excel"
        ],
        "exportCurrentView": true,
        "exportAll": true,
        "filename": "daily-collection"
      }
    },
    {
      "id": "payment-mode-wise-collection",
      "type": "table",
      "title": "Payment Mode Wise Collection Summary",
      "description": "Payment Mode Wise Collection Summary",
      "width": 6,
