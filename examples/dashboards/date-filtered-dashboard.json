{
  "id": "orders-date-filter-dashboard",
  "title": "Orders by Date",
  "description": "Required shared date range with per-widget field mapping, table export, stat and chart widgets.",
  "layout": { "columns": 12, "tabletColumns": 6, "mobileColumns": 1 },
  "dateFilterBehavior": "required",
  "filters": [{ "field": "OrderDate", "label": "Order Date", "type": "daterange", "operator": "between", "required": true }],
  "widgets": [
    { "id": "orders-table", "type": "table", "title": "Orders", "width": 6, "position": { "x": 0, "y": 1 }, "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["OrderId", "OrderDate", "Amount"] }, "columns": [{ "field": "OrderId", "header": "Order" }, { "field": "OrderDate", "header": "Date", "dataType": "date" }, { "field": "Amount", "header": "Amount", "dataType": "number" }], "sort": [{ "field": "OrderDate", "direction": "DESC" }], "pageSize": 10, "export": { "enabled": true, "formats": ["csv", "excel"], "exportAll": true } },
    { "id": "shipments-table", "type": "table", "title": "Shipments", "width": 6, "position": { "x": 6, "y": 1 }, "filterFields": { "OrderDate": "ShippedDate" }, "request": { "action": "select", "source": { "table": "DemoShipments" }, "fields": ["ShipmentId", "ShippedDate"] }, "columns": [{ "field": "ShipmentId", "header": "Shipment" }, { "field": "ShippedDate", "header": "Shipped", "dataType": "date" }], "pageSize": 10 },
    { "id": "order-total", "type": "stat", "title": "Order Total", "width": 4, "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": [{ "function": "SUM", "field": "Amount", "alias": "TotalAmount" }] }, "valueField": "TotalAmount", "format": "currency" },
    { "id": "orders-by-status", "type": "chart", "title": "Orders by Status", "width": 8, "request": { "action": "select", "source": { "table": "DemoOrders" }, "fields": ["Status", { "function": "COUNT", "field": "*", "alias": "OrderCount" }], "groupBy": ["Status"] }, "chartType": "bar", "xField": "Status", "yField": "OrderCount", "showTooltip": true, "showGrid": true }
  ]
}
