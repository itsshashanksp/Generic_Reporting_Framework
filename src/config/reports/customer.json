{
  "id": "customer",
  "title": "Customer Report",
  "description": "Displays all customers.",

  "toolbar": {
    "search": true,
    "export": true,
    "refresh": true,
    "settings": false
  },

"grid": {
    "pagination": {
        "enabled": true,
        "pageSize": 5000,
        "pageSizeOptions": [25, 50, 100]
    },
    "rowSelection": "multiple"
},

  "columns": [
    {
      "field": "Cust_Name",
      "header": "Customer Name"
    },
    {
      "field": "Cust_Add",
      "header": "Address"
    },
    {
      "field": "Cust_Mob",
      "header": "Mobile"
    }
  ],

"filters": [
    {
        "field": "Cust_Name",
        "label": "Customer Name",
        "type": "text"
    },
    {
        "field": "Cust_Add",
        "label": "Address",
        "type": "text"
    }
],

  "request": {
    "controller": "Query",
    "action": "select",
    "table": "CustomerTable",
    "columns": ["*"]
  }
}